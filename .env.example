# Base URL of the NestJS backend API (no trailing slash, no /api suffix).
# Used server-side for direct data fetching, and by next.config.ts to proxy
# same-origin /api/* requests so the backend's httpOnly auth cookies work.
NEXT_PUBLIC_API_URL=http://localhost:4000

# Public URL of this frontend site (used for canonical URLs, sitemap, JSON-LD).
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# WhatsApp number fallback is configured via Admin -> Settings, not here.
# This is only used if you wire up analytics/other client code that needs it
# before Settings loads. Safe to leave blank.
NEXT_PUBLIC_WHATSAPP_NUMBER=

# Optional: Google Analytics measurement ID (see README > Analytics).
NEXT_PUBLIC_GA_ID=
